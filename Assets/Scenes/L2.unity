  landingHeightOffset: 0
  dropHeight: 30
  dropTime: 0.6
  entranceAnimation: Witch
  idleAnimation: Witch
  idleBlend: 0.5
  impactMaterial: {fileID: 0}
  impact:
    ringRadius: 7
    ringWidth: 1.2
    ringTime: 0.5
    floorOffset: 0.05
    ringIntensity: 3
    debrisCount: 16
    debrisSize: 0.6
    debrisUpSpeed: {x: 7, y: 12}
