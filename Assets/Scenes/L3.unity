--- !u!114 &333006431
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 333006428}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 450864607d716f94cbbf3a47e75ab166, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightAndShadow.PuppeteerIntro
  dialogueDelay: 0.5
  boss: {fileID: 8264838262126252254, guid: b5fc697847ad07e418838ca7fa2af7f5, type: 3}
  bossName: The Puppeteer
  bossPoint: {fileID: 0}
  hideDepth: 200
  arena: {fileID: 1101942321}
  puppets:
  - prefab: {fileID: 6360503928981304619, guid: 2cc6340effb68064c89b0d5b06725912, type: 3}
    weight: 1
  puppetCount: 4
  puppetMinRadius: 4
  puppetMaxRadius: 8
  puppetsAfterLine: 1
  dialogue:
  - speaker: Puppeteer
    text: 'Hee hee, hoo hoo.

      Who are you?'
  - speaker: Puppeteer
    text: 'So the prisoner is dead.

      And you''re the one who took her head.'
  - speaker: Puppeteer
    text: 'So it is the Emperor that you seek?

      How? You are so weak.'
  - speaker: Puppeteer
    text: 'You and I live on strings.

      But it seems you still don''t know anything.'
  - speaker: Puppeteer
    text: 'I will make you into a toy.

      Then the emperor will cry with joy.'
  - speaker: Puppeteer
    text: 'I can finally get back on their good side.

      My brilliance will not
      be denied!'
  - speaker: 
    text: Enough talk.
