    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: activateQuestion.text
      value: Acquire?
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: 'requires.Array.data[0]'
      value: 
      objectReference: {fileID: 2057248094}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: stats.Array.data[0].text
      value: 'Primary Passive: Damage grants stacks, which can trigger a burst of
        damage and ability cooldown reduction.


        Ability: Summon a field
        that grants bonus attack speed.'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[1].cost
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[2].cost
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: stats.Array.data[0].speaker
      value: Banjo
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[0].dialogue.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[1].dialogue.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[2].dialogue.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[0].dialogue.Array.data[0].text
      value: 'Who is this grand marque?

        That stands before me?'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[0].dialogue.Array.data[1].text
      value: 'Why I must say you are courageous.

        To dare to restore us.'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[0].dialogue.Array.data[2].text
      value: 'Our purpose is rotten to the core.

        We are weapons of war.'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[1].dialogue.Array.data[0].text
      value: 'There was once a travelling musician.

        To spread the faith
        was her mission.'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[1].dialogue.Array.data[1].text
      value: 'A hope for one, a hope for all.

        They forced her to crawl.'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[1].dialogue.Array.data[2].text
      value: 'Begging for a mercy.

        With a rock, they ended her journey.'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[2].dialogue.Array.data[0].text
      value: 'How can she trust another?

        How can she find a lover?'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[2].dialogue.Array.data[1].text
      value: 'Happiness is a delusion.

        I want to go into seclusion.'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[2].dialogue.Array.data[2].text
      value: 'Still you offer me your hand?

        Don''t you find me rather bland?'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[2].dialogue.Array.data[3].text
      value: 'Ha... okay.

        I suppose I could do with a little holiday.'
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[0].dialogue.Array.data[0].speaker
      value: Blue
      objectReference: {fileID: 0}
    - target: {fileID: 4972656822287759497, guid: d83c0624d41654b48a6dd3a0b6be211b, type: 3}
      propertyPath: levels.Array.data[0].dialogue.Array.data[1].speaker
