  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1072ace340d52344485ef289ff855ada, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightAndShadow.EmperorAudience
  room: {fileID: 279564316}
  luna: {fileID: 11400000, guid: cf0e79b4c4053784ebf2dc1c0b53669f, type: 2}
  strikePoint: {fileID: 6034529885570065087}
  pierce: 0
  hoverPoint: {fileID: 1137213521}
  hoverRise: 2
  turnCamera: 1
  cameraTurnTime: 1
  opening:
  - speaker: The Emperor
    text: W-who are you? How did you get in here?
  - speaker: The Emperor
    text: Iris? Where's Iris? Guards?
  - speaker: Luna
    text: My dear chromatist, we've made it this far. Kill her.
  - speaker: The Emperor
    text: P-please. Y-you're scaring me.
  question:
    speaker: Luna
    text: Kill her now.
  yesLabel: Yes
  noLabel: No
  afterYes:
  - speaker: Luna
    text: ...
  - speaker: Luna
    text: Our revenge is complete.
  - speaker: Luna
    text: Thanks to you, my dear chromatist, I was able to have a taste of royal
      blood.
  - speaker: Luna
    text: Ah, now I have regained my former self, as I was before I was cast away
      by the royalty.
  - speaker: Luna
    text: They tossed me aside, said I couldn't be controlled.
  - speaker: Luna
    text: Of course I could not be controlled! I am the one at the helm!
  - speaker: Luna
    text: I AM A GODDESS!
  - speaker: Luna
    text: And you will my first loyal subject.
  - speaker: Luna
    text: My vessel.
  - speaker: Luna
    text: Whether you wish to or not.
  beforeNoStrike:
  - speaker: Luna
    text: That was no question.
  - speaker: Luna
    text: You think you can control me?
  afterNo:
  - speaker: Luna
    text: I cannot believe you. You gave up your quest for revenge.
  - speaker: Luna
    text: What about the ones who they had killed?
  - speaker: Luna
    text: You would let them get away with it?
  - speaker: Luna
    text: You are weak.
  - speaker: Luna
    text: 'But that is alright. Thanks to you, my dear chromatist, I was able to
      have a taste of royal blood. '
  - speaker: Luna
    text: Ah, now I have regained my former self, as I was before I was cast away
      by the royalty.
  - speaker: Luna
    text: They tossed me aside, said I couldn't be controlled.
  - speaker: Luna
    text: Of course I could not be controlled! I am the one at the helm!
  - speaker: Luna
    text: I AM A GODDESS!
  - speaker: Luna
    text: And you will my first loyal subject.
  - speaker: Luna
    text: My vessel.
  - speaker: Luna
    text: Whether you wish to or not.
