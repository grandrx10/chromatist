--- !u!114 &629400549
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 629400539}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 875e947bbaa0aa14fa91df7d8b706072, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightAndShadow.LunaCaptives
  weapons:
  - blade: {fileID: 11400000, guid: 149208d6c0e3a9f4985dbc1b60dfd560, type: 2}
    bossPrefab: {fileID: 4804827407026896392, guid: f5c227dd00407e248b5aaffaaf10a000, type: 3}
    owned: 1
    saveDialogue:
    - speaker: Amber
      text: 'Heh. Thanks boss, for snapping me back to me senses. '
    - speaker: Amber
      text: Now lets get to firing her!
    levelThreeSaveDialogue:
    - speaker: Amber
      text: 'Heh. Thanks boss, for snapping me back to me senses. '
    - speaker: Amber
      text: Have you seen a fish bigger than her? She's... better than me in every
        way. We don't stand a chance.
    - speaker: Amber
      text: What? You... think I'm... prettier...?
    - speaker: Amber
      text: 'Heh. Boss, let''s go kick her ass. '
    chainColour: {r: 0.5943396, g: 0.08435446, b: 0, a: 0}
  - blade: {fileID: 11400000, guid: 5dc0fa1ccd6e4d7a9b2b54a575b7c9ba, type: 2}
    bossPrefab: {fileID: 4804827407026896392, guid: 9fdc5c896e2cbd945b78dc845835753d, type: 3}
    owned: 1
    saveDialogue:
    - speaker: Lavender
      text: 'Sorry, I was lost in a dream. Someone was hunting me. '
    - speaker: Lavender
      text: It was cold.
    - speaker: Lavender
      text: But then you pulled me out of it. Thank you.
    levelThreeSaveDialogue:
    - speaker: Lavender
      text: 'Sorry, I was lost in a dream. Someone was hunting me. '
    - speaker: Lavender
      text: It was cold.
    - speaker: Lavender
      text: But then, I heard the call of my wingman. My one and only wingman.
    - speaker: Lavender
      text: A voice warmer than any winter.
    - speaker: Lavender
      text: Thank you for being my wingman.
    - speaker: Lavender
      text: Now, let us hunt this wicked beast.
    chainColour: {r: 0.2540807, g: 0, b: 0.59607846, a: 0}
  - blade: {fileID: 11400000, guid: 3a2a01e353ff22340b8de05852bdf090, type: 2}
    bossPrefab: {fileID: 4804827407026896392, guid: 0110b8373a347b241bdde6b5317a7226, type: 3}
    owned: 1
    saveDialogue:
    - speaker: Rose
      text: Hmf. You actually came to save me.
    - speaker: Rose
      text: I suppose commoners like you aren't so bad after all.
    - speaker: Rose
      text: Shall we have one last dance?
    levelThreeSaveDialogue:
    - speaker: Rose
      text: You... risked your life to save me?
    - speaker: Rose
      text: Idiot. You were serious when you said I mattered, weren't you?
    - speaker: Rose
      text: Hmf. Well in that case, I shan't hold back either.
    - speaker: Rose
      text: You're important to me too, okay? So you better not die on me.
    - speaker: Rose
      text: Come on, let's do this dance one last time.
    chainColour: {r: 0.745283, g: 0.0738252, b: 0.1970584, a: 0}
  - blade: {fileID: 11400000, guid: c400266a961c40fe98cd46a8a1ff20d0, type: 2}
    bossPrefab: {fileID: 4804827407026896392, guid: 3e8c369108215bd41972a7346c59c3c4, type: 3}
    owned: 1
    saveDialogue:
    - speaker: Scarlett
      text: I knew you'd come back.
    levelThreeSaveDialogue: []
    chainColour: {r: 0.4264151, g: 0.00080768316, b: 0, a: 0}
  - blade: {fileID: 11400000, guid: 8f8e469f5c0c7c14aae8710026916630, type: 2}
    bossPrefab: {fileID: 4804827407026896392, guid: 77324fc7d7697e34fa99e06a41226c9c, type: 3}
    owned: 1
    saveDialogue:
    - speaker: Sage
      text: I knew you'd come back.
    levelThreeSaveDialogue: []
    chainColour: {r: 0, g: 0.5377358, b: 0.116317905, a: 0}
  - blade: {fileID: 11400000, guid: f8e2a86010132b94e886076efc42cddb, type: 2}
    bossPrefab: {fileID: 4804827407026896392, guid: 6eca3c04106e3324d83c2a72da10ff55, type: 3}
    owned: 1
    saveDialogue:
    - speaker: Blue
      text: I knew you'd come back.
    levelThreeSaveDialogue: []
    chainColour: {r: 0, g: 0.09524184, b: 0.5372549, a: 0}
  lunaIntro: {fileID: 629400547}
  opening:
  - speaker: Luna
    text: I gave you everything you had.
  - speaker: Luna
    text: You OWE everything to me.
  - speaker: Luna
    text: Without me, you were just another worthless body on the pile.
  - speaker: Luna
    text: You died protecting a child, you know that?
  - speaker: Luna
    text: But do not worry. That weakness is one that I can purge from your being.
  - speaker: 
    text: All hope is lost.
  firstQuestion:
    speaker: 
    text: Who do you call you to?
  nextQuestion:
    speaker: 
    text: Who do you call to next?
