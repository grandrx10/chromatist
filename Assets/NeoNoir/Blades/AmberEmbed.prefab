--- !u!114 &7501193424126467851
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2189733109407162466}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1bef1a939cc2879479bbf31090c44e4e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LightAndShadow.PurchasableBlade
  blade: {fileID: 11400000, guid: 5dc0fa1ccd6e4d7a9b2b54a575b7c9ba, type: 2}
  requires:
  - {fileID: 7475608414203499530, guid: 901cbc4f9d411bc40811e35afcb0fe0b, type: 3}
  bladeModel: {fileID: 5202430251053348051}
  stoneRenderers:
  - {fileID: 8148323739431339850}
  interactRadius: 2.5
  promptText: E  Interact
  promptOffset: {x: 0, y: 0.3, z: 0}
  stats:
  - speaker: 
    text: 'Primary Passive: Shots boomerang.


      Ability: Charge up briefly,
      dealing massive damage. Gain slow and resistance while charging.'
  activateQuestion:
    speaker: 
    text: Acquire
  upgradeQuestion:
    speaker: 
    text: Upgrade?
  yesLabel: Yes
  noLabel: No
  notEnoughChroma:
    speaker: 
    text: Not enough chroma.
  levels:
  - cost: 1
    dialogue:
    - speaker: Amber
      text: Oi! Who dares wake me from my slumber?
    - speaker: Amber
      text: What? You have a job offer for me? Don't you know who I am?
    - speaker: Amber
      text: I am the splitter of mountains, terror of the South!
    - speaker: Amber
      text: But yes, I'll accept your offer of employment.
    - speaker: Amber
      text: Do you pay in milk bread? It's been a while since I've last eaten some...
  - cost: 1
    dialogue:
    - speaker: Amber
      text: Yer back again? What, got another job for me?
    - speaker: Amber
      text: Yer... just visiting? Well... ehm... what do you employers usually do
        with their employees?
    - speaker: Amber
      text: You want to talk about me?
    - speaker: Amber
      text: Well, I was once a great warrior of the South, I tell ye. I was battling
        with the greatworms as if they were moderately sized worms - I once wrestled
        a horned lion to the ground with my bare hands!
    - speaker: Amber
      text: But alas, we all die someday. Some sooner than others.
    - speaker: Amber
      text: Why am I even talking about this with ye, eh? Idiot!
  - cost: 1
    dialogue:
    - speaker: Amber
      text: What took ye so long? I thought ye weren't ever coming back.
    - speaker: Amber
      text: Not that I would care. Of course.
    - speaker: Amber
      text: You remind me a lot about someone I knew when I was alive.
    - speaker: Amber
      text: They were a brilliant chromatist, and I dare say stronger than I.
    - speaker: Amber
      text: They were the only one who had bested me. It wasn't even close.
    - speaker: Amber
      text: I thought all this time I was the strongest, but I was just a moderately
        sized fish in a small pond. What hubris.
    - speaker: Amber
      text: Eh? You think I'm pretty strong?
    - speaker: Amber
      text: Har har! You always know how to cheer a gal up don't ye, boss?
    - speaker: Amber
      text: Thanks.
  acquiredStoneColour: {r: 0.83396226, g: 0.30469903, b: 0, a: 1}
  stoneDelay: 0
  stoneChangeTime: 0.6
  bladeGlow: 3
  holdWithoutEffect: 0.8
  acquired:
    m_PersistentCalls:
      m_Calls: []
  upgradeEffect:
